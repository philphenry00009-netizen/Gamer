#!/bin/sh
# Simple Gradle wrapper for CI

set -e

GRADLE_VERSION="8.2"
GRADLE_ZIP="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
GRADLE_HOME="gradle/wrapper/dists/gradle-${GRADLE_VERSION}"

if [ ! -d "$GRADLE_HOME" ]; then
  echo "Downloading Gradle ${GRADLE_VERSION}..."
  mkdir -p gradle/wrapper
  curl -L "$GRADLE_ZIP" -o /tmp/gradle.zip
  unzip -q /tmp/gradle.zip -d gradle/wrapper
  echo "Gradle ${GRADLE_VERSION} ready."
else
  echo "Gradle ${GRADLE_VERSION} already present."
fi

# Run Gradle
exec "$GRADLE_HOME/bin/gradle" "$@"
